<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Saving a backup into Downloads on Android 9 and older, where there is
         no MediaStore route. From Android 10 the scoped store needs nothing. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <!-- Post notifications. Runtime-requested from Android 13, and without it
         every notification this app posts is silently dropped by the system
         rather than refused, which is indistinguishable from a bug. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Re-posting the badge when something changes while the app is closed. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Android 14+ refuses a foreground service without a declared type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Mirroring a calendar entry to the phone's own calendar. Asked for at
         the moment the user approves an entry, never at startup, and the app
         works fully without it: the in-app calendar needs no permission. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
    <!-- Android 11 scopes package visibility: without this, an implicit
         VIEW intent at https://wa.me/... can silently resolve to nothing, and
         launchUrl returns false with no error anywhere. The button would then
         show "WhatsApp is not installed" on a phone that has it installed —
         the one failure mode that looks like the user's fault. -->
    <queries>
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

    <application
        android:label="Koru"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Tapping a Koru notification. singleTop so the running app is
                 brought forward and handed the link instead of being rebuilt
                 behind the notification, which would lose the conversation. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="koru" android:host="attention"/>
            </intent-filter>
        </activity>

        <!-- The home screen widget. Exported because the launcher is a
             different app and has to be able to send it broadcasts; the
             receiver reads nothing and draws nothing on its own, it only ever
             repaints what Dart already decided. -->
        <receiver
            android:name=".KoruWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.abduljabbar.koru.WIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/koru_widget_info"/>
        </receiver>

        <!-- Restarts the attention watcher after a reboot, and on a slow
             hourly tick. The receiver holds no state and decides nothing, it
             only puts back what the app already decided. -->
        <receiver
            android:name=".AttentionRestarter"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="com.abduljabbar.koru.CHECK"/>
            </intent-filter>
        </receiver>

        <!-- Keeps Koru's attention checks running when the app is closed.
             Not optional and not incidental: a service that can do this work
             with the app closed has to be a foreground service, and Android
             requires one to show a permanent notification. That is the deal, and
             it is the same one every reminder app on the store makes. -->
        <service
            android:name=".AttentionWatcher"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <meta-data android:name="flutterEmbedding" android:value="2"/>
    </application>
</manifest>
