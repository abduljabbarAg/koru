<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown by Android between tapping the icon and Flutter drawing its first frame.

  Deliberately a plain brand-coloured field and nothing else. It used to carry a
  static crest of the splash artwork, which meant a new user saw two splashes in
  a row: a still mascot on this background, then the animated one — the first
  looked like a screen that had frozen. A blank field of the same colour hands
  over to the animated splash with no second logo and no white flash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/koru_cream" />
</layer-list>
