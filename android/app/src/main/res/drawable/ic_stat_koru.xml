<?xml version="1.0" encoding="utf-8"?>
<!--
  The mascot, as the status bar icon.

  Android tints a small icon to a flat silhouette and discards colour, so this
  is drawn the way the notification bar will actually show it: one colour, no
  detail below what survives being shrunk to 24dp. The face is cut out of the
  shell rather than drawn on top of it, because a filled eye in a silhouette
  reads as a smudge at this size.

  Same character as the launcher icon and the splash crest, so the thing that
  speaks to you at 9am is the same thing that answered you when you tapped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Sprout: a stem with two leaves, the fern on the mascot's head. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.45,8.2 L11.45,3.4 A0.65,0.65 0 1,1 12.75,3.4 L12.75,8.2 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.5,6.0 C9.5,6.0 8.0,4.9 8.0,3.4 C10.0,3.4 11.5,4.5 11.5,6.0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.6,7.0 C14.6,7.0 16.1,5.9 16.1,4.4 C14.1,4.4 12.6,5.5 12.6,7.0 Z" />

    <!-- Shell, with the eyes and the smile punched out of it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,7.8 C15.6,7.8 18.6,10.9 18.6,14.6 C18.6,18.3 15.6,21.4 12,21.4 C8.4,21.4 5.4,18.3 5.4,14.6 C5.4,10.9 8.4,7.8 12,7.8 Z M9.1,13.6 a1.0,1.0 0 1,0 2.0,0 a1.0,1.0 0 1,0 -2.0,0 Z M12.9,13.6 a1.0,1.0 0 1,0 2.0,0 a1.0,1.0 0 1,0 -2.0,0 Z M10.0,16.6 A2.3,2.3 0 0,0 14.0,16.6 L14.0,15.7 A2.3,2.3 0 0,1 10.0,15.7 Z" />
</vector>